# School Admission System — Docker Compose environment configuration
#
# Copy this file to .env and adjust values as needed:
#   Copy-Item .env.example .env
#
# The .env file is git-ignored and must never be committed.

# --- PostgreSQL ---
POSTGRES_DB=school_admission
POSTGRES_USER=school_admission
POSTGRES_PASSWORD=change-this-local-password

# --- Host port mappings ---
# Backend is expected at http://localhost:8080 by default.
# If port 8080 is occupied on your host (e.g. by an unrelated Oracle service),
# set BACKEND_HOST_PORT=8081 in your local .env override.
# The internal container port remains 8080 regardless.
BACKEND_HOST_PORT=8080

FRONTEND_HOST_PORT=3000

# --- ASP.NET Core ---
ASPNETCORE_ENVIRONMENT=Production

# --- Hold duration (seconds) ---
# Default reservation lifetime. Must be a positive 32-bit integer.
HOLD_DURATION_SECONDS=600

# --- Background expiration worker ---
HOLD_EXPIRATION_INTERVAL_SECONDS=5
HOLD_EXPIRATION_BATCH_SIZE=50
